<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karoo to Home Assistant Integration"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"/>

        <ImageButton
            android:id="@+id/toggleSettingsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Toggle Settings"/>
    </RelativeLayout>

    <!-- Scrolling Container for the devices list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sensorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic list items will be injected here by MainActivity.kt -->

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Status Bar -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Listening to Karoo SDK..."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginTop="12dp"
        android:gravity="center"/>

    <!-- MQTT Settings (Expandable) -->
    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:background="#1A1A1A"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Assistant MQTT Settings"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/mqttHostEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT Broker IP (e.g. 192.168.1.5)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="14sp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/homeSsidEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Home WiFi SSID"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="14sp"
            android:singleLine="true"/>

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_gravity="end"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#00AAFF"/>

        <Button
            android:id="@+id/syncNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync to Home Assistant Now"
            android:layout_marginTop="4dp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
